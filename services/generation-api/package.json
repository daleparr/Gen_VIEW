    "asyncpg": "^0.29.0",
    "redis": "^5.0.1",
    "celery": "^5.3.4",
    "torch": "^2.1.0",
    "torchvision": "^0.16.0",
    "transformers": "^4.35.0",
    "diffusers": "^0.24.0",
    "clip-by-openai": "^1.0",
    "chromadb": "^0.4.18",
