# GEN-VIEW-KSE Generation API Environment Configuration
# Copy this file to .env and update the values for your environment

# Application Settings
APP_NAME="GEN-VIEW-KSE Generation API"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true

# Database Configuration
DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/gen_view_kse"
DATABASE_ECHO=false

# Redis Configuration
REDIS_URL="redis://localhost:6379/0"
REDIS_MAX_CONNECTIONS=20

# Celery Configuration
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# ChromaDB Configuration
CHROMADB_HOST="localhost"
CHROMADB_PORT=8000
CHROMADB_COLLECTION_NAME="fashion_embeddings"

# AI Model Configuration
MODEL_CACHE_DIR="./models"
MAX_CONCURRENT_GENERATIONS=4
GENERATION_TIMEOUT=300

# StyleGAN3 Configuration
STYLEGAN_CHECKPOINT_PATH="./models/stylegan3-fashion.pkl"
STYLEGAN_DEVICE="cuda"

# CLIP Configuration
CLIP_MODEL_NAME="ViT-B/32"
CLIP_DEVICE="cuda"

# Stable Diffusion Configuration
DIFFUSION_MODEL_NAME="stabilityai/stable-diffusion-xl-base-1.0"
DIFFUSION_DEVICE="cuda"

# NeRF Configuration
NERF_MODEL_PATH="./models/instant-ngp"
NERF_DEVICE="cuda"

# Security Configuration
SECRET_KEY="your-super-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM="HS256"

# CORS Configuration
ALLOWED_ORIGINS="*"
ALLOWED_METHODS="*"
ALLOWED_HEADERS="*"

# Performance Configuration
MAX_WORKERS=4
REQUEST_TIMEOUT=60
MAX_REQUEST_SIZE=10485760

# Logging Configuration
LOG_LEVEL="INFO"
LOG_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s"

# KSE Substrate Configuration
KSE_MEMORY_ENABLED=true
KSE_TEMPORAL_REASONING=true
KSE_CROSS_MODAL_LEARNING=true

# Cloud Storage (Optional)
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_S3_BUCKET=""
# AWS_REGION="us-east-1"

# Monitoring (Optional)
# SENTRY_DSN=""
# PROMETHEUS_ENABLED=false
# JAEGER_ENABLED=false